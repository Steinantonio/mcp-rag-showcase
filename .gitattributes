# Normalize line endings: LF in the repository, LF on checkout everywhere.
# CRLF in Dockerfiles or shell scripts breaks Linux CI in ways that are hard to read.
* text=auto eol=lf

*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.zip binary
